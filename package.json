{
	"name": "iobroker.yahka-config",
	"version": "0.0.1",
	"description": "yahka-config",
	"author": {
		"name": "Albert Salai",
		"email": "albert2013@salai.de"
	},
	"homepage": "https://github.com/albert-salai/ioBroker.yahka-config",
	"license": "MIT",
	"keywords": [],
	"repository": {
		"type": "git",
		"url": "git@github.com:albert-salai/ioBroker.yahka-config.git"
	},
	"engines": {
		"node": ">= 24"
	},
	"dependencies": {
		"@iobroker/adapter-core": "^3.4.3",
		"deep-diff": "^1.0.2",
		"mqtt": "^5.16.1",
		"sprintf-js": "^1.1.3"
	},
	"devDependencies": {
		"@alcalzone/release-script": "^5.2.1",
		"@alcalzone/release-script-plugin-iobroker": "^5.2.0",
		"@alcalzone/release-script-plugin-license": "^5.2.2",
		"@alcalzone/release-script-plugin-manual-review": "^5.2.0",
		"@iobroker/adapter-dev": "^1.5.0",
		"@iobroker/eslint-config": "^2.3.4",
		"@iobroker/testing": "^6.3.1",
		"@tsconfig/node24": "^24.0.5",
		"@tsconfig/strictest": "^2.0.8",
		"@types/chai": "^4.3.20",
		"@types/chai-as-promised": "^7.1.8",
		"@types/deep-diff": "^1.0.5",
		"@types/iobroker": "npm:@iobroker/types@^7.2.5",
		"@types/node": "^24.19.2",
		"@types/sinon-chai": "^3.2.12",
		"@types/sprintf-js": "^1.1.4",
		"chai": "^4.5.0",
		"chai-as-promised": "^7.1.2",
		"rimraf": "^6.1.3",
		"sinon-chai": "^3.7.0",
		"source-map-support": "^0.5.21",
		"tsx": "^4.23.15",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.1"
	},
	"main": "build/main.js",
	"files": [
		"admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).{json,json5}",
		"admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
		"build/",
		"www/",
		"io-package.json",
		"LICENSE"
	],
	"scripts": {
		"postinstall": "test -d build || npm run build",
		"prebuild": "rimraf build",
		"build": "build-adapter ts",
		"watch": "build-adapter ts --watch",
		"prebuild:ts": "rimraf build",
		"build:ts": "build-adapter ts",
		"watch:ts": "build-adapter ts --watch",
		"test:ts": "mocha --config test/mocharc.custom.json src/**/*.test.ts",
		"test:package": "mocha test/package --exit",
		"test:integration": "mocha test/integration --exit",
		"test": "npm run test:ts && npm run test:package",
		"check": "tsc --noEmit",
		"lint": "eslint -c eslint.config.mjs .",
		"translate": "translate-adapter",
		"release": "release-script",
		"verify": "npm run check && npm run lint && npm run build && npm test"
	},
	"bugs": {
		"url": "https://github.com/albert-salai/ioBroker.yahka-config/issues"
	},
	"readmeFilename": "README.md",
	"allowScripts": {
		"esbuild": true,
		"diskusage": true,
		"unix-dgram": true,
		"protobufjs": false
	}
}
